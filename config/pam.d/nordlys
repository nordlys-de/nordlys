# PAM service for the Nordlys lock screen (nordlys-shell lock).
# Install: sudo install -m644 config/pam.d/nordlys /etc/pam.d/nordlys
# Without it the lock screen uses the "login" service, which is the same.
auth        include     login
# Unlocking also unlocks the keyring again if something locked it.
-auth       optional    pam_gnome_keyring.so
