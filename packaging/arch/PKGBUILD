# Nordlys from git, for Arch and CachyOS.
#
#   cd packaging/arch && makepkg -si
#
# While the repository is private, makepkg clones it with your git
# credentials (gh auth setup-git, or an SSH URL below).

pkgname=nordlys-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="A frosted, keyboard-first desktop on Hyprland"
arch=(x86_64 aarch64)
url="https://github.com/nordlys-de/nordlys"
license=(LicenseRef-unknown)   # not chosen yet
depends=(
    hyprland hypridle swaybg
    xdg-desktop-portal-hyprland xdg-desktop-portal-gtk hyprpolkitagent
    pam libxkbcommon wayland
    libinput seatd mesa libdrm systemd-libs
    inter-font ttf-jetbrains-mono
    wireplumber
)
optdepends=(
    'playerctl: now-playing controls'
    'networkmanager: Wi-Fi toggle and the Network page in Settings'
    'bluez-utils: Bluetooth toggle and the Bluetooth page in Settings'
    'brightnessctl: brightness keys, idle dimming and the brightness slider'
    'power-profiles-daemon: power modes in Settings'
    'hyprsunset: night light in Settings'
    'zenity: picking a wallpaper file in Settings'
    'grim: Super+Shift+S screenshots'
    'slurp: Super+Shift+S screenshots'
    'wl-clipboard: Super+Shift+S screenshots'
    'foot: the terminal (Super+Enter)'
    'qt6ct: Qt apps in the Nordlys palette'
    'adw-gtk-theme: GTK 3 apps in the Nordlys palette'
    'libnotify: a notice when Print saves a screenshot'
    'xdg-user-dirs: ~/Pictures and friends for the file manager and screenshots'
    'dconf: Inter and JetBrains Mono as the GTK fonts unless you pick others'
    'nautilus: the file manager (Super+N)'
    'gvfs: trash, phones and network places in the file manager'
    'ffmpegthumbnailer: video thumbnails in the file manager'
    'imv: the image viewer'
    'mpv: the video and music player'
    'mpv-mpris: mpv in the ambient rail (now playing)'
    'zathura-pdf-mupdf: the PDF and EPUB viewer'
    'gnome-text-editor: the text editor (Super+E)'
    'helix: the terminal editor in the "Nordlys dev" group'
    'btop: the system monitor (Ctrl+Shift+Esc)'
    'pavucontrol: per-app volume'
    'file-roller: archives'
    'gnome-keyring: saved passwords for browsers, VS Code and git (the Secret Service)'
    'libsecret: git credential helper and apps that store passwords'
    'seahorse: see and manage saved passwords'
    'wf-recorder: screen recording (Super+R)'
    'gpu-screen-recorder: screen recording, when wf-recorder is missing'
    'cliphist: clipboard history (Super+V)'
    'sddm: the Nordlys login screen'
    'xwayland-satellite: X11 apps on the nordlys-comp session'
)
makedepends=(cargo git)
provides=(nordlys)
conflicts=(nordlys)
backup=(etc/pam.d/nordlys)
source=("nordlys::git+$url.git")
sha256sums=(SKIP)

pkgver() {
    cd nordlys
    printf '%s.r%s.g%s' \
        "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)" \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd nordlys
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd nordlys
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p nordlys-comp -p nordlys-shell -p nordlysctl -p nordlys-theme -p nordlys-settings
}

check() {
    cd nordlys
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release -p nordlys-comp -p nordlys-shell -p nordlysctl -p nordlys-theme -p nordlys-settings -p nordlys-config -p nordlys-stage
}

package() {
    cd nordlys
    sh scripts/install.sh --prefix /usr --destdir "$pkgdir"
}
