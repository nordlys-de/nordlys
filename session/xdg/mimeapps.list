# Nordlys's default apps. nordlys-session puts this file on XDG_CONFIG_DIRS,
# so it only fills gaps: anything in ~/.config/mimeapps.list ("Open With",
# xdg-mime default …) wins. Where an entry lists several apps, the first
# one installed is used.

[Default Applications]
# Folders
inode/directory=org.gnome.Nautilus.desktop;
# Images
image/png=imv.desktop;org.gnome.Loupe.desktop;
image/jpeg=imv.desktop;org.gnome.Loupe.desktop;
image/gif=imv.desktop;org.gnome.Loupe.desktop;
image/webp=imv.desktop;org.gnome.Loupe.desktop;
image/avif=imv.desktop;org.gnome.Loupe.desktop;
image/heic=imv.desktop;org.gnome.Loupe.desktop;
image/heif=imv.desktop;org.gnome.Loupe.desktop;
image/jxl=imv.desktop;org.gnome.Loupe.desktop;
image/bmp=imv.desktop;org.gnome.Loupe.desktop;
image/tiff=imv.desktop;org.gnome.Loupe.desktop;
image/svg+xml=imv.desktop;org.gnome.Loupe.desktop;
image/x-portable-pixmap=imv.desktop;org.gnome.Loupe.desktop;
image/x-portable-graymap=imv.desktop;org.gnome.Loupe.desktop;
image/x-tga=imv.desktop;org.gnome.Loupe.desktop;
image/x-icon=imv.desktop;org.gnome.Loupe.desktop;
image/vnd.microsoft.icon=imv.desktop;org.gnome.Loupe.desktop;
image/qoi=imv.desktop;org.gnome.Loupe.desktop;
# Video
video/mp4=mpv.desktop;
video/x-matroska=mpv.desktop;
video/webm=mpv.desktop;
video/quicktime=mpv.desktop;
video/x-msvideo=mpv.desktop;
video/mpeg=mpv.desktop;
video/ogg=mpv.desktop;
video/x-flv=mpv.desktop;
video/3gpp=mpv.desktop;
video/mp2t=mpv.desktop;
video/x-ms-wmv=mpv.desktop;
# Audio
audio/mpeg=mpv.desktop;
audio/mp4=mpv.desktop;
audio/flac=mpv.desktop;
audio/ogg=mpv.desktop;
audio/opus=mpv.desktop;
audio/x-wav=mpv.desktop;
audio/wav=mpv.desktop;
audio/aac=mpv.desktop;
audio/x-m4a=mpv.desktop;
audio/webm=mpv.desktop;
audio/x-matroska=mpv.desktop;
audio/x-vorbis+ogg=mpv.desktop;
audio/x-mpegurl=mpv.desktop;
application/vnd.apple.mpegurl=mpv.desktop;
# Documents
application/pdf=org.pwmt.zathura-pdf-mupdf.desktop;org.pwmt.zathura.desktop;org.gnome.Papers.desktop;
application/epub+zip=org.pwmt.zathura-pdf-mupdf.desktop;org.pwmt.zathura.desktop;org.gnome.Papers.desktop;
application/x-cbz=org.pwmt.zathura-pdf-mupdf.desktop;org.pwmt.zathura.desktop;org.gnome.Papers.desktop;
application/vnd.comicbook+zip=org.pwmt.zathura-pdf-mupdf.desktop;org.pwmt.zathura.desktop;org.gnome.Papers.desktop;
image/vnd.djvu=org.pwmt.zathura-djvu.desktop;org.pwmt.zathura.desktop;
image/vnd.djvu+multipage=org.pwmt.zathura-djvu.desktop;org.pwmt.zathura.desktop;
# Text and code (Super+, opens nordlys.toml with this)
text/plain=org.gnome.TextEditor.desktop;Helix.desktop;
text/markdown=org.gnome.TextEditor.desktop;Helix.desktop;
text/x-log=org.gnome.TextEditor.desktop;Helix.desktop;
application/toml=org.gnome.TextEditor.desktop;Helix.desktop;
application/x-toml=org.gnome.TextEditor.desktop;Helix.desktop;
text/x-toml=org.gnome.TextEditor.desktop;Helix.desktop;
application/json=org.gnome.TextEditor.desktop;Helix.desktop;
application/x-yaml=org.gnome.TextEditor.desktop;Helix.desktop;
application/yaml=org.gnome.TextEditor.desktop;Helix.desktop;
application/xml=org.gnome.TextEditor.desktop;Helix.desktop;
text/x-csrc=org.gnome.TextEditor.desktop;Helix.desktop;
text/x-chdr=org.gnome.TextEditor.desktop;Helix.desktop;
text/x-c++src=org.gnome.TextEditor.desktop;Helix.desktop;
text/x-python=org.gnome.TextEditor.desktop;Helix.desktop;
text/x-rust=org.gnome.TextEditor.desktop;Helix.desktop;
text/x-shellscript=org.gnome.TextEditor.desktop;Helix.desktop;
application/x-shellscript=org.gnome.TextEditor.desktop;Helix.desktop;
text/x-lua=org.gnome.TextEditor.desktop;Helix.desktop;
text/css=org.gnome.TextEditor.desktop;Helix.desktop;
text/javascript=org.gnome.TextEditor.desktop;Helix.desktop;
application/javascript=org.gnome.TextEditor.desktop;Helix.desktop;
text/csv=org.gnome.TextEditor.desktop;Helix.desktop;
# Archives
application/zip=org.gnome.FileRoller.desktop;
application/x-tar=org.gnome.FileRoller.desktop;
application/gzip=org.gnome.FileRoller.desktop;
application/x-compressed-tar=org.gnome.FileRoller.desktop;
application/x-bzip2-compressed-tar=org.gnome.FileRoller.desktop;
application/x-xz-compressed-tar=org.gnome.FileRoller.desktop;
application/zstd=org.gnome.FileRoller.desktop;
application/x-zstd-compressed-tar=org.gnome.FileRoller.desktop;
application/x-7z-compressed=org.gnome.FileRoller.desktop;
application/vnd.rar=org.gnome.FileRoller.desktop;
application/x-rar=org.gnome.FileRoller.desktop;
# Web
text/html=firefox.desktop;chromium.desktop;
application/xhtml+xml=firefox.desktop;chromium.desktop;
x-scheme-handler/http=firefox.desktop;chromium.desktop;
x-scheme-handler/https=firefox.desktop;chromium.desktop;
x-scheme-handler/about=firefox.desktop;chromium.desktop;
