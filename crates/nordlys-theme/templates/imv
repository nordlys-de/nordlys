# Generated by nordlys-theme from nordlys.toml. It rewrites this file while
# this first line is here; delete the line to keep your own changes.
# imv, the Nordlys image viewer. Keys: imv(5); y copies the image.

[options]
background = %ground.bare%
overlay = false
overlay_font = Inter:11
overlay_text_color = %text.bare%
overlay_background_color = %surface.bare%
overlay_background_alpha = dd
overlay_position_bottom = true
overlay_text = ${imv_current_index}/${imv_file_count}  ·  ${imv_current_file}  ·  ${imv_width}×${imv_height}  ·  ${imv_scale}%
title_text = ${imv_current_file} — imv
scaling_mode = shrink
suppress_default_binds = false

[binds]
y = exec wl-copy < "$imv_current_file"
